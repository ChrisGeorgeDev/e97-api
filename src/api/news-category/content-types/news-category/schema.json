{
  "kind": "collectionType",
  "collectionName": "news_categories",
  "info": {
    "singularName": "news-category",
    "pluralName": "news-categories",
    "displayName": "News Category",
    "description": "A tag applied to News articles (e.g. Investment Opportunity, Company News)."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "newsArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "newsCategories"
    }
  }
}
