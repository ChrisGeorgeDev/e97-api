{
  "kind": "collectionType",
  "collectionName": "accounts",
  "info": {
    "singularName": "account",
    "pluralName": "accounts",
    "displayName": "Account",
    "description": "An investor entity (company/household) that owns portal data and can have multiple linked users."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "e97ID": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "accountCategories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::account-category.account-category",
      "inversedBy": "accounts"
    },
    "users": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::users-permissions.user",
      "mappedBy": "account"
    },
    "documents": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::document.document",
      "mappedBy": "account"
    },
    "portfolioReports": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::portfolio-report.portfolio-report",
      "mappedBy": "account"
    },
    "properties": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::property.property",
      "mappedBy": "account"
    },
    "invitations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::invitation.invitation",
      "mappedBy": "account"
    },
    "interestRegistrations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::interest-registration.interest-registration",
      "mappedBy": "account"
    }
  }
}
