{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "A shared real-estate development update, visible to every logged-in investor."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "string"
    },
    "phase": {
      "type": "enumeration",
      "enum": [
        "Pre-Development",
        "Under Construction",
        "Fully Realized"
      ]
    },
    "progress": {
      "type": "integer",
      "min": 0,
      "max": 100
    },
    "targetRoi": {
      "type": "string"
    },
    "totalBudget": {
      "type": "string"
    },
    "costToDate": {
      "type": "string"
    },
    "highlight": {
      "type": "string"
    },
    "description": {
      "type": "richtext"
    },
    "newsArticles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::news-article.news-article",
      "mappedBy": "projects"
    }
  }
}
