HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Clerk (frontend auth verification + invitation creation)
CLERK_SECRET_KEY=
# Optional: PEM public key from the Clerk Dashboard for networkless JWT verification.
# Falls back to a network JWKS fetch via CLERK_SECRET_KEY if unset.
CLERK_JWT_KEY=
# Comma-separated allowed frontend origins (Clerk's azp claim allowlist), e.g.
# http://localhost:3000,https://portal.example.com
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SIGNING_SECRET=

# Investor portal frontend URL, used to build the invitation's redirect_url
INVESTOR_PORTAL_URL=http://localhost:3000

# Resend (interest-registration notification emails) — raw fetch to Resend's
# API, no npm provider package. RESEND_FROM_EMAIL's domain must be verified
# in the Resend account or sends will fail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Defaults to info@east97.ca in code if unset.
INTEREST_NOTIFICATION_EMAIL=info@east97.ca

# Azure Blob Storage (strapi-provider-upload-azure-sa) — the only community
# upload provider for Azure; Strapi ships no official one. Use EITHER
# AZURE_STORAGE_ACCOUNT_KEY (shared key — file URLs come back unsigned) OR
# AZURE_STORAGE_SAS_TOKEN (a static, container-wide SAS — file URLs come
# back with that one token attached, not a per-file/per-request signed URL).
# A non-empty SAS token takes priority over the account key if both are set.
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_CONTAINER=
